# Copia este fichero como .env y rellénalo:  cp .env.example .env

# ---- Acceso ---------------------------------------------------------------
# Contraseña que pide la web (compartida por toda la casa). Déjala vacía solo si
# proteges la web de otra forma (p. ej. Cloudflare Access).
APP_PASSWORD=cambia-esto

# ---- Catálogo ---------------------------------------------------------------
# Enlaces magnet que se cargan al arrancar (uno por línea o separados por comas).
# También se pueden añadir desde la página de Ajustes.
MAGNETS=

# Opcional: una URL (página web, fichero de texto, RSS…) donde se publiquen los
# magnets nuevos. Se revisa periódicamente y cada magnet nuevo se añade solo.
MAGNET_FEED_URL=
MAGNET_FEED_INTERVAL_HOURS=24

# Espacio máximo para los libros ya descargados (MB). Al llenarse se borran los
# que hace más tiempo que nadie pide. El catálogo en sí ocupa ~50 MB por 150.000 libros.
CACHE_MAX_MB=1024

# ---- Correo para Send to Kindle --------------------------------------------
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
# Este remitente debe estar en la "Lista de e-mails aprobados" de Amazon.
SMTP_FROM=tu-cuenta@gmail.com

# ---- BitTorrent (normalmente no hace falta tocarlo) -------------------------
TORRENT_PORT=6881
# Límite de subida en KB/s (0 = sin límite).
TORRENT_UPLOAD_LIMIT_KBPS=0
# Segundos sin encontrar a nadie que comparta un libro antes de rendirse.
TORRENT_PEER_TIMEOUT=120
TORRENT_DOWNLOAD_TIMEOUT=900

# Idioma que se pone a los EPUB que no lo indican (Amazon lo exige).
DEFAULT_LANGUAGE=es

# ---- Cloudflare Tunnel (biblioteca.baltajmn.dev) -----------------------------
# Token del túnel creado en Cloudflare Zero Trust → Networks → Tunnels.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
